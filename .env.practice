# Sao chép file này thành .env rồi điền giá trị.
# Không có OPENAI_API_KEY -> server tự chạy chế độ SCRIPTED (không gọi LLM).

# --- LLM (mọi endpoint tương thích OpenAI, có tool calling) ---------------
OPENAI_API_KEY=sk-xxxx
MODEL=gemini-xxx
OPENAI_BASE_URL=https://xxx/v1
# OPENAI_BASE_URL=https://openrouter.ai/api/v1      (MODEL=openai/gpt-4o-mini)
# OPENAI_BASE_URL=http://localhost:11434/v1         (Ollama, MODEL=qwen2.5:7b, OPENAI_API_KEY=ollama)
TEMPERATURE=0

# --- Virtual context (MemGPT §2.2) ---------------------------------------
CONTEXT_LIMIT=4000   # "RAM" giả lập, độc lập với context thật của model
WARN_FRAC=0.70       # ngưỡng chèn cảnh báo memory pressure
FLUSH_FRAC=1.00      # ngưỡng flush
EVICT_FRAC=0.50      # mỗi lần flush evict khoảng 50% context (FIFO)

# --- Khác -----------------------------------------------------------------
PERSONA_LIMIT=600    # giới hạn ký tự block persona
HUMAN_LIMIT=800      # giới hạn ký tự block human
PAGE_SIZE=5          # số kết quả mỗi trang khi search
SCRIPTED_DELAY=0.7   # độ trễ "suy nghĩ" giả lập ở chế độ SCRIPTED (giây)
# PAPERS_DIR=..      # thư mục chứa PDF nạp vào archival (mặc định: thư mục cha)
